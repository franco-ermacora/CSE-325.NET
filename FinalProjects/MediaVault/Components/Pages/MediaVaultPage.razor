@page "/mediavault"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MediaVault.Data
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Media Vault - Mis Libros y Películas</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Media Vault</h2>
        <span class="badge bg-primary fs-6">Colección Personal</span>
    </div>

    <!-- W04-02 & W04-03: Formulario Único para Crear y Editar -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header @(isEditing ? "bg-warning text-dark" : "bg-dark text-white")">
            <h5 class="mb-0">
                @(isEditing ? "✏️ Editar Libro o Película" : "➕ Añadir Nuevo Libro o Película")
            </h5>
        </div>
        <div class="card-body">
            <EditForm Model="currentItem" OnValidSubmit="HandleValidSubmit" FormName="MediaItemForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label font-weight-bold">Título</label>
                        <InputText @bind-Value="currentItem.Title" class="form-control" placeholder="Ej: Inception / El Principito" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label font-weight-bold">Tipo</label>
                        <InputSelect @bind-Value="currentItem.MediaType" class="form-select">
                            <option value="Movie">Película</option>
                            <option value="Book">Libro</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label font-weight-bold">Género</label>
                        <InputText @bind-Value="currentItem.Genre" class="form-control" placeholder="Ej: Sci-Fi, Drama" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label font-weight-bold">Estado</label>
                        <InputSelect @bind-Value="currentItem.Status" class="form-select">
                            <option value="Pending">Pendiente</option>
                            <option value="Completed">Completado</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label font-weight-bold">Calificación (1-5)</label>
                        <InputNumber @bind-Value="currentItem.Rating" class="form-control" min="1" max="5" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label font-weight-bold">Notas / Reseña</label>
                        <InputTextArea @bind-Value="currentItem.Notes" class="form-control" rows="2" placeholder="Opinión o comentarios breves..." />
                    </div>
                </div>

                <div class="mt-3 text-end">
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-secondary me-2" @onclick="CancelEdit">Cancelar</button>
                        <button type="submit" class="btn btn-warning px-4">💾 Guardar Cambios</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success px-4">➕ Guardar en Galería</button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <!-- W04-01: Filtros y Dashboard -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h4>Mi Galería</h4>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="FilterByType">
                <option value="All">Todos los Tipos</option>
                <option value="Movie">Películas</option>
                <option value="Book">Libros</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @onchange="FilterByStatus">
                <option value="All">Todos los Estados</option>
                <option value="Pending">Pendientes</option>
                <option value="Completed">Completados</option>
            </select>
        </div>
    </div>

    <!-- W04-01: Grilla con registros solo del usuario logueado -->
    @if (filteredItems == null)
    {
        <p><em>Cargando tu colección...</em></p>
    }
    else if (!filteredItems.Any())
    {
        <div class="alert alert-info text-center">
            No se encontraron registros. ¡Añade tu primer libro o película arriba!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(item.MediaType == "Movie" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @(item.MediaType == "Movie" ? "🎬 Película" : "📖 Libro")
                                </span>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                    @(item.Status == "Completed" ? "✓ Completado" : "⏳ Pendiente")
                                </span>
                            </div>

                            <h5 class="card-title text-truncate">@item.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">Género: @(string.IsNullOrEmpty(item.Genre) ? "N/A" : item.Genre)</h6>
                            
                            <p class="card-text mb-1">
                                <strong>Calificación:</strong> 
                                <span class="text-warning">
                                    @for (int i = 0; i < item.Rating; i++) { <span>★</span> }
                                    @for (int i = item.Rating; i < 5; i++) { <span class="text-muted">☆</span> }
                                </span>
                            </p>

                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <p class="card-text text-secondary small"><em>"@item.Notes"</em></p>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditItem(item)">
                                    ✏️ Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleStatus(item)">
                                    @(item.Status == "Completed" ? "⏳ Reabrir" : "✓ Marcar Completado")
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => PromptDelete(item)">
                                🗑️ Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- W04-04: Modal de Confirmación de Eliminación -->
@if (itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas eliminar <strong>"@itemToDelete.Title"</strong> de tu colección?</p>
                    <p class="text-muted small mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private MediaItem currentItem = new();
    private MediaItem? itemToDelete;
    private List<MediaItem>? userItems;
    private List<MediaItem>? filteredItems;
    private string currentUserId = string.Empty;
    private bool isEditing = false;

    private string selectedTypeFilter = "All";
    private string selectedStatusFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        userItems = await DbContext.MediaItems
            .Where(m => m.UserId == currentUserId)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        ApplyFilters();
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;

        if (isEditing)
        {
            // Búsqueda del elemento existente en la BD para modificarlo limpiamente
            var existingItem = await DbContext.MediaItems.FindAsync(currentItem.Id);
            if (existingItem != null && existingItem.UserId == currentUserId)
            {
                existingItem.Title = currentItem.Title;
                existingItem.MediaType = currentItem.MediaType;
                existingItem.Genre = currentItem.Genre;
                existingItem.Status = currentItem.Status;
                existingItem.Rating = currentItem.Rating;
                existingItem.Notes = currentItem.Notes;

                await DbContext.SaveChangesAsync();
            }
            isEditing = false;
        }
        else
        {
            currentItem.UserId = currentUserId;
            currentItem.CreatedAt = DateTime.UtcNow;

            DbContext.MediaItems.Add(currentItem);
            await DbContext.SaveChangesAsync();
        }

        currentItem = new MediaItem();
        await LoadData();
    }

    private void EditItem(MediaItem item)
    {
        currentItem = new MediaItem
        {
            Id = item.Id,
            Title = item.Title,
            MediaType = item.MediaType,
            Genre = item.Genre,
            Status = item.Status,
            Rating = item.Rating,
            Notes = item.Notes,
            CreatedAt = item.CreatedAt,
            UserId = item.UserId
        };
        isEditing = true;
    }

    private void CancelEdit()
    {
        currentItem = new MediaItem();
        isEditing = false;
    }

    private async Task ToggleStatus(MediaItem item)
    {
        var existingItem = await DbContext.MediaItems.FindAsync(item.Id);
        if (existingItem != null)
        {
            existingItem.Status = existingItem.Status == "Completed" ? "Pending" : "Completed";
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }

    private void PromptDelete(MediaItem item)
    {
        itemToDelete = item;
    }

    private void CancelDelete()
    {
        itemToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (itemToDelete != null)
        {
            var existingItem = await DbContext.MediaItems.FindAsync(itemToDelete.Id);
            if (existingItem != null)
            {
                DbContext.MediaItems.Remove(existingItem);
                await DbContext.SaveChangesAsync();
            }
            itemToDelete = null;
            await LoadData();
        }
    }

    private void FilterByType(ChangeEventArgs e)
    {
        selectedTypeFilter = e.Value?.ToString() ?? "All";
        ApplyFilters();
    }

    private void FilterByStatus(ChangeEventArgs e)
    {
        selectedStatusFilter = e.Value?.ToString() ?? "All";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (userItems == null) return;

        filteredItems = userItems.Where(item =>
            (selectedTypeFilter == "All" || item.MediaType == selectedTypeFilter) &&
            (selectedStatusFilter == "All" || item.Status == selectedStatusFilter)
        ).ToList();
    }
}