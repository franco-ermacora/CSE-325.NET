@page "/mediavault"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MediaVault.Data
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Media Vault - Mis Libros y Películas</PageTitle>

<main class="container mt-4" id="main-content">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">📚 Media Vault</h1>
        <span class="badge bg-primary fs-6">Colección Personal</span>
    </header>

    <!-- W05-04: Alerta de Éxito / Feedback Visual Temporizado -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <span>✅ @successMessage</span>
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty" aria-label="Cerrar mensaje"></button>
        </div>
    }

    <!-- W05-01 & W05-03: Formulario con Accesibilidad WAG / <label> vinculados -->
    <section class="card mb-4 shadow-sm border-0">
        <div class="card-header @(isEditing ? "bg-warning text-dark" : "bg-dark text-white")">
            <h2 class="h5 mb-0">
                @(isEditing ? "✏️ Editar Libro o Película" : "➕ Añadir Nuevo Libro o Película")
            </h2>
        </div>
        <div class="card-body">
            <EditForm Model="currentItem" OnValidSubmit="HandleValidSubmit" FormName="MediaItemForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" role="alert" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="titleInput" class="form-label fw-bold">Título *</label>
                        <InputText id="titleInput" @bind-Value="currentItem.Title" class="form-control" placeholder="Ej: Inception / El Principito" aria-required="true" />
                    </div>
                    <div class="col-md-2">
                        <label for="typeSelect" class="form-label fw-bold">Tipo</label>
                        <InputSelect id="typeSelect" @bind-Value="currentItem.MediaType" class="form-select">
                            <option value="Movie">Película</option>
                            <option value="Book">Libro</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label for="genreInput" class="form-label fw-bold">Género</label>
                        <InputText id="genreInput" @bind-Value="currentItem.Genre" class="form-control" placeholder="Ej: Sci-Fi, Drama" />
                    </div>
                    <div class="col-md-2">
                        <label for="statusSelect" class="form-label fw-bold">Estado</label>
                        <InputSelect id="statusSelect" @bind-Value="currentItem.Status" class="form-select">
                            <option value="Pending">Pendiente</option>
                            <option value="Completed">Completado</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label for="ratingInput" class="form-label fw-bold">Calificación (1-5)</label>
                        <InputNumber id="ratingInput" @bind-Value="currentItem.Rating" class="form-control" min="1" max="5" />
                    </div>
                    <div class="col-md-12">
                        <label for="notesInput" class="form-label fw-bold">Notas / Reseña</label>
                        <InputTextArea id="notesInput" @bind-Value="currentItem.Notes" class="form-control" rows="2" placeholder="Opinión o comentarios breves..." />
                    </div>
                </div>

                <div class="mt-3 text-end">
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-secondary me-2" @onclick="CancelEdit">Cancelar</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">💾 Guardar Cambios</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success px-4 fw-bold">➕ Guardar en Galería</button>
                    }
                </div>
            </EditForm>
        </div>
    </section>

    <!-- W05-01: Filtros de Búsqueda -->
    <section class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2 class="h4">Mi Galería</h2>
        </div>
        <div class="col-md-3 col-6 mb-2 mb-md-0">
            <label for="filterType" class="visually-hidden">Filtrar por Tipo</label>
            <select id="filterType" class="form-select" @onchange="FilterByType" aria-label="Filtrar por Tipo">
                <option value="All">Todos los Tipos</option>
                <option value="Movie">Películas</option>
                <option value="Book">Libros</option>
            </select>
        </div>
        <div class="col-md-3 col-6 mb-2 mb-md-0">
            <label for="filterStatus" class="visually-hidden">Filtrar por Estado</label>
            <select id="filterStatus" class="form-select" @onchange="FilterByStatus" aria-label="Filtrar por Estado">
                <option value="All">Todos los Estados</option>
                <option value="Pending">Pendientes</option>
                <option value="Completed">Completados</option>
            </select>
        </div>
    </section>

    <!-- W05-04: Loading States / Spinner de carga -->
    @if (isLoading)
    {
        <div class="spinner-container" aria-live="polite">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando colección...</span>
            </div>
        </div>
    }
    else if (filteredItems == null || !filteredItems.Any())
    {
        <!-- W05-04: Empty Database / Feedback estado vacío -->
        <div class="alert alert-info text-center p-4 shadow-sm rounded border-0" role="status">
            <h5>📭 Tu colección está vacía</h5>
            <p class="mb-0 text-muted">No se encontraron registros que coincidan con tus filtros. ¡Añade tu primer libro o película arriba!</p>
        </div>
    }
    else
    {
        <!-- W05-02: Responsive Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(item.MediaType == "Movie" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @(item.MediaType == "Movie" ? "🎬 Película" : "📖 Libro")
                                </span>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                    @(item.Status == "Completed" ? "✓ Completado" : "⏳ Pendiente")
                                </span>
                            </div>

                            <h3 class="h5 card-title text-truncate mb-1">@item.Title</h3>
                            <p class="card-subtitle mb-2 text-muted small">Género: @(string.IsNullOrEmpty(item.Genre) ? "N/A" : item.Genre)</p>
                            
                            <p class="card-text mb-2">
                                <span class="fw-bold">Calificación:</span> 
                                <span class="text-warning" aria-label="Calificación @item.Rating de 5 estrellas">
                                    @for (int i = 0; i < item.Rating; i++) { <span aria-hidden="true">★</span> }
                                    @for (int i = item.Rating; i < 5; i++) { <span class="text-muted" aria-hidden="true">☆</span> }
                                </span>
                            </p>

                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <p class="card-text text-secondary small fst-italic">"@item.Notes"</p>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditItem(item)" aria-label="Editar @item.Title">
                                    ✏️
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleStatus(item)">
                                    @(item.Status == "Completed" ? "⏳ Reabrir" : "✓ Completar")
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => PromptDelete(item)" aria-label="Eliminar @item.Title">
                                🗑️
                            </button>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</main>

<!-- W04 & W05: Modal Accesible -->
@if (itemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-modal="true" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalTitle">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas eliminar <strong>"@itemToDelete.Title"</strong> de tu colección?</p>
                    <p class="text-muted small mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private MediaItem currentItem = new();
    private MediaItem? itemToDelete;
    private List<MediaItem>? userItems;
    private List<MediaItem>? filteredItems;
    private string currentUserId = string.Empty;
    private bool isEditing = false;
    private bool isLoading = true;
    private string successMessage = string.Empty;

    private string selectedTypeFilter = "All";
    private string selectedStatusFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            await LoadData();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        await Task.Delay(300); // Pequeño delay para visualización suave del spinner

        userItems = await DbContext.MediaItems
            .Where(m => m.UserId == currentUserId)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        ApplyFilters();
        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;

        if (isEditing)
        {
            var existingItem = await DbContext.MediaItems.FindAsync(currentItem.Id);
            if (existingItem != null && existingItem.UserId == currentUserId)
            {
                existingItem.Title = currentItem.Title;
                existingItem.MediaType = currentItem.MediaType;
                existingItem.Genre = currentItem.Genre;
                existingItem.Status = currentItem.Status;
                existingItem.Rating = currentItem.Rating;
                existingItem.Notes = currentItem.Notes;

                await DbContext.SaveChangesAsync();
                successMessage = $"'{currentItem.Title}' actualizado correctamente.";
            }
            isEditing = false;
        }
        else
        {
            currentItem.UserId = currentUserId;
            currentItem.CreatedAt = DateTime.UtcNow;

            DbContext.MediaItems.Add(currentItem);
            await DbContext.SaveChangesAsync();
            successMessage = $"'{currentItem.Title}' añadido a tu galería.";
        }

        currentItem = new MediaItem();
        await LoadData();
    }

    private void EditItem(MediaItem item)
    {
        currentItem = new MediaItem
        {
            Id = item.Id,
            Title = item.Title,
            MediaType = item.MediaType,
            Genre = item.Genre,
            Status = item.Status,
            Rating = item.Rating,
            Notes = item.Notes,
            CreatedAt = item.CreatedAt,
            UserId = item.UserId
        };
        isEditing = true;
        successMessage = string.Empty;
    }

    private void CancelEdit()
    {
        currentItem = new MediaItem();
        isEditing = false;
    }

    private async Task ToggleStatus(MediaItem item)
    {
        var existingItem = await DbContext.MediaItems.FindAsync(item.Id);
        if (existingItem != null)
        {
            existingItem.Status = existingItem.Status == "Completed" ? "Pending" : "Completed";
            await DbContext.SaveChangesAsync();
            successMessage = $"Estado de '{item.Title}' actualizado.";
            await LoadData();
        }
    }

    private void PromptDelete(MediaItem item)
    {
        itemToDelete = item;
    }

    private void CancelDelete()
    {
        itemToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (itemToDelete != null)
        {
            var existingItem = await DbContext.MediaItems.FindAsync(itemToDelete.Id);
            if (existingItem != null)
            {
                DbContext.MediaItems.Remove(existingItem);
                await DbContext.SaveChangesAsync();
                successMessage = $"'{itemToDelete.Title}' fue eliminado de tu colección.";
            }
            itemToDelete = null;
            await LoadData();
        }
    }

    private void FilterByType(ChangeEventArgs e)
    {
        selectedTypeFilter = e.Value?.ToString() ?? "All";
        ApplyFilters();
    }

    private void FilterByStatus(ChangeEventArgs e)
    {
        selectedStatusFilter = e.Value?.ToString() ?? "All";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (userItems == null) return;

        filteredItems = userItems.Where(item =>
            (selectedTypeFilter == "All" || item.MediaType == selectedTypeFilter) &&
            (selectedStatusFilter == "All" || item.Status == selectedStatusFilter)
        ).ToList();
    }
}